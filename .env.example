# Local development only: create a PostgreSQL database first, then copy to .env.
DATABASE_URL=postgresql://godown:CHANGE_ME@localhost:5432/godown
# Production: use the provider's pooled PostgreSQL URL with certificate verification.
# DIRECT_URL=postgresql://USER:PASSWORD@DIRECT_HOST/DATABASE?sslmode=verify-full
NEXTAUTH_URL=http://localhost:3000
# Generate independent random values: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET=REPLACE_WITH_RANDOM_64_HEX_CHARACTERS
BACKUP_ENCRYPTION_KEY=REPLACE_WITH_DIFFERENT_RANDOM_64_HEX_CHARACTERS
CRON_SECRET=REPLACE_WITH_ANOTHER_RANDOM_64_HEX_VALUE
# One-time new-client bootstrap. Set all five in secure hosting settings, then remove them after first successful startup.
# INITIAL_COMPANY_NAME=
# INITIAL_OWNER_NAME=
# INITIAL_OWNER_EMAIL=
# INITIAL_OWNER_PASSWORD=
# INITIAL_OWNER_PIN=
# INITIAL_COMPANY_ADDRESS=Lahore
# Optional scheduled email. The company email in Settings receives the note.
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=Godown Ledger <reports@your-verified-domain.example>
# ADMIN_EMAIL=
# Optional WhatsApp: approved template body has exactly one text parameter.
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_API_VERSION=
# WHATSAPP_TEMPLATE_NAME=
# WHATSAPP_TEMPLATE_LANGUAGE=en
# EVENING_WHATSAPP_TO=923001234567
# Optional encrypted offsite backup storage (private bucket).
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
