# ── Required ──────────────────────────────────────────────────────────────
# Postgres connection string (e.g. from Neon, Supabase, Railway, or your own server)
DATABASE_URL=postgresql://user:password@host:5432/godown_ledger

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# Public URL of the deployment (e.g. https://godown-ledger.vercel.app)
NEXTAUTH_URL=http://localhost:3000

# ── Optional: transactional email (password reset, bi-weekly report) ───────
# RESEND_API_KEY=re_your_key_here
# RESEND_FROM_EMAIL=onboarding@resend.dev
# ADMIN_EMAIL=owner@example.com

# ── Optional: Vercel Cron auth for /api/cron/report and /api/cron/backup ───
# Vercel sends this automatically as "Authorization: Bearer $CRON_SECRET"
# CRON_SECRET=

# ── Optional: encrypted backups ─────────────────────────────────────────────
# BACKUP_ENCRYPTION_KEY=
# RESTORE_APPROVAL_SECRET=

# ── Optional: Cloudflare R2 storage for backups (instead of email) ─────────
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
